            ],
            "centroidWithin": {
              "minX": 0.35,
              "maxX": 0.65,
              "minY": 0.02,
              "maxY": 0.22
            }
          },
          {
            "label": "background",
            "fraction": [
              0.92,
              0.99
            ]
          }
        ],
        "maxOther": 0.01,
        "confidence": null
      },
      "inMode": {

{
  "domain": "vision",
  "task": "image_segmenter",
  "heading": "Image Segmentation",
  "samples": {
    "python": "examples/image_segmentation/python/image_segmentation.py",
    "android": "examples/image_segmentation/android/category_mask",
    "ios": "examples/image_segmentation/ios"
  },
  "models": [
    {
      "id": "deeplab_v3",
      "asset": "deeplab_v3.tflite"
    },
    {
      "id": "hair_segmenter",
      "asset": "hair_segmenter.tflite"
    },
    {
      "id": "selfie_segmenter",
      "asset": "selfie_segmenter.tflite"
    },
    {
      "id": "selfie_segmenter_landscape",
      "asset": "selfie_segmenter_landscape.tflite"
    },
    {
      "id": "selfie_multiclass",
      "asset": "selfie_multiclass_256x256.tflite"
    }
  ],
  "modes": [
    {
      "id": "image-category",
      "options": {
        "runningMode": "IMAGE"
      }
    },
    {
      "id": "image-confidence",
      "options": {
        "runningMode": "IMAGE"
      }
    },
    {
      "id": "video",
      "options": {
        "runningMode": "VIDEO"
      }
    }
  ],
  "note": "DeepLab runs on the riders/horse photo of the notebook; the hair and selfie models run on business-person.png (a woman from the waist up, hair tied at the top of her head). In mode \"image-confidence\" the confidence masks are requested too, and the one of \"confidenceCategory\" is checked and written to mask.png instead of the category mask.",
  "tests": [
    {
      "models": [
        "deeplab_v3"
      ],
      "about": "The category mask must contain person, horse, background in the share of the photo each occupies.",
      "files": {
        "mask": "mask.png",
        "blurred": "blurred_background.png"
      },
      "steps": [
        {
          "key": "segmentation_input_rotation0.jpg",
          "image": "segmentation_input_rotation0.jpg",
          "caption": "Two girls on a horse, and a woman"
        }
      ],
      "expect": {
        "type": "segmentation",
        "labelCount": 21,
        "classes": [
          {
            "label": "person",
            "fraction": [
              0.2,
              0.45
            ],
            "centroidWithin": {
              "minX": 0.15,
              "maxX": 0.45,
              "minY": 0.4,
              "maxY": 0.7
            }
          },
          {
            "label": "horse",
            "fraction": [
              0.15,
              0.4
            ],
            "centroidWithin": {
              "minX": 0.45,
              "maxX": 0.8,
              "minY": 0.6,
              "maxY": 0.9
            }
          },
          {
            "label": "background",
            "fraction": [
              0.25,
              0.5
            ]
          }
        ],
        "maxOther": 0.03,
        "confidence": null
      },
      "inMode": {
        "image-confidence": {
          "about": "The category mask must contain person, horse, background in the share of the photo each occupies. Confidence mask \"person\" is also verified.",
          "options": {
            "confidenceCategory": "person"
          },
          "expect": {
            "confidence": {
              "label": "person",
              "fraction": [
                0.2,
                0.45
              ],
              "minPeak": 0.8,
              "centroidWithin": {
                "minX": 0.15,
                "maxX": 0.45,
                "minY": 0.4,
                "maxY": 0.7
              }
            }
          }
        }
      }
    },
    {
      "models": [
        "hair_segmenter"
      ],
      "about": "The category mask must contain hair, background in the share of the photo each occupies.",
      "files": {
        "mask": "mask.png",
        "blurred": "blurred_background.png"
      },
      "steps": [

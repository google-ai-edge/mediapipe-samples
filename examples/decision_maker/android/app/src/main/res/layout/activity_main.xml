<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/toolbar_background"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:src="@drawable/media_pipe_banner" />
        </androidx.appcompat.widget.Toolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabQuestionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:tabIndicatorColor="@color/mp_color_primary"
            app:tabSelectedTextColor="@color/mp_color_primary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_boolean" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_choice" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_score" />
        </com.google.android.material.tabs.TabLayout>

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/btnEvaluate"
            app:layout_constraintTop_toBottomOf="@id/tabQuestionType">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Result -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/input_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_result"
                            android:textAllCaps="true"
                            android:textColor="@color/label_text_color"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/tv_result_placeholder"
                            android:textColor="@color/label_text_color"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvResultSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/label_text_color"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/resultBars"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Input text -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/FieldBox"
                    android:layout_marginTop="20dp"
                    android:hint="@string/label_input_text">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInputText"
                        style="@style/FieldBoxInput"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Boolean: single condition -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/conditionLayout"
                    style="@style/FieldBox"
                    android:hint="@string/label_condition">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etQuestion"
                        style="@style/FieldBoxInput"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Boolean: decision threshold -->
                <LinearLayout
                    android:id="@+id/thresholdSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/title_threshold" />

                        <TextView
                            android:id="@+id/tvThresholdValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/mp_color_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="0.50" />
                    </LinearLayout>

                    <TextView
                        style="@style/SectionHelper"
                        android:text="@string/helper_threshold" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/title_threshold"
                        android:stepSize="0.05"
                        android:valueFrom="0.05"
                        android:valueTo="0.95"
                        app:thumbColor="@color/mp_color_primary"
                        app:trackColorActive="@color/mp_color_primary" />
                </LinearLayout>

                <!-- Choice options / Score rubric levels -->
                <LinearLayout
                    android:id="@+id/itemsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvItemsTitle"
                        style="@style/SectionTitle" />

                    <TextView
                        android:id="@+id/tvItemsHelper"
                        style="@style/SectionHelper" />

                    <LinearLayout
                        android:id="@+id/itemsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddItem"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/instructionsLayout"
                    style="@style/FieldBox"
                    android:hint="@string/label_instructions">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etInstructions"
                        style="@style/FieldBoxInput"
                        android:minLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Shown while the model loads or a question is being evaluated. -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:indicatorColor="@color/mp_color_primary"
            app:layout_constraintTop_toBottomOf="@id/tabQuestionType" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEvaluate"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="@dimen/evaluate_button_margin_bottom"
            android:backgroundTint="@color/mp_color_primary"
            android:text="@string/btn_evaluate"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/bottom_sheet_layout"
        layout="@layout/info_bottom_sheet" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

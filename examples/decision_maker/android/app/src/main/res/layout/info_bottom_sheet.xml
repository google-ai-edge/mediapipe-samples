<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_bottom_sheet"
    android:elevation="12dp"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp"
    app:behavior_hideable="false"
    app:behavior_peekHeight="@dimen/bottom_sheet_peek_height"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: always visible while the sheet is collapsed. Tap to expand. -->
        <LinearLayout
            android:id="@+id/sheet_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_sheet_peek_height"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/alt_bottom_sheet_handle"
            android:orientation="vertical">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Peek height (64dp) minus the handle and its top margin (14dp). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_settings"
                    android:textColor="@color/title_text_color"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inference_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/label_inference_time"
                    android:textColor="@color/label_text_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/inference_time_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:fontFeatureSettings="tnum"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="@string/inference_time_placeholder"
                    android:textColor="@color/mp_color_primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/sheet_divider" />

        <!-- Delegate: segmented CPU / GPU toggle. -->
        <TextView
            style="@style/SheetLabel"
            android:text="@string/label_delegate" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_delegate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cpu"
                style="@style/DelegateButton"
                android:text="@string/delegate_cpu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gpu"
                style="@style/DelegateButton"
                android:text="@string/delegate_gpu" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Model: exposed dropdown menu. -->
        <TextView
            style="@style/SheetLabel"
            android:text="@string/label_models" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/mp_color_primary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:saveEnabled="false"
                android:textSize="16sp"
                app:simpleItems="@array/models_spinner_titles" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
